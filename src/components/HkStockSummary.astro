---
import stock from "../data/osprey-hk-stock.json";
interface Props { storeId: string }
const {storeId} = Astro.props;
type Offer = {status:string; qty?:number; price?:number; url?:string; sku?:string};
type Entry = {note?:string; evidence?:string; evidenceLinks?:{label:string;url:string}[]; sharedEvidenceStoreId?:string; "26"?:Offer; "28"?:Offer};
const stores = stock.stores as Record<string,Entry>;
const entry = stores[storeId] || {};
const record = entry.sharedEvidenceStoreId ? stores[entry.sharedEvidenceStoreId] || {} : entry;
const dateText=stock.checkedAt.replace(/-(\d{2})-(\d{2})$/,(_,m,d)=>"年"+Number(m)+"月"+Number(d)+"日");
const statusLabel: Record<string,string> = {in:"网店有货",out:"网店缺货",unavailable:"网店不可售",unlisted:"未列黑色",unknown:"待确认"};
const offers = (["26","28"] as const).map(size => ({size, offer: record[size] || {status:"unknown"} as Offer}));
---
<div class="stock-summary" data-stock-store={storeId}>
  {offers.map(({size,offer}) => (
    <div class="stock-row" data-size={size} data-status={offer.status}>
      <strong>{size} L</strong>
      <span class:list={["stock-state",offer.status]}>{statusLabel[offer.status]}{offer.qty !== undefined ? " · "+offer.qty+" 件" : ""}</span>
      <span class="stock-price">{offer.price !== undefined ? "HK$"+offer.price.toLocaleString("en-US") : "—"}</span>
      {offer.url && <a href={offer.url} target="_blank" rel="noopener noreferrer" aria-label={size+" L 商品证据"}>商品 ↗</a>}
    </div>
  ))}
  <p class="branch-state">实体店库存：待确认</p>
  {record.note && <p class="stock-note">{record.note}</p>}
  {record.evidence && <details class="stock-evidence"><summary>库存依据 · <time datetime={stock.checkedAt}>{dateText}</time></summary><p>{record.evidence}</p>{record.evidenceLinks && <p class="evidence-links">{record.evidenceLinks.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</p>}</details>}
</div>
