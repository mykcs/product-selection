---
import '../styles/tailwind.css';
interface Props { lang: string; head: string; bodyAttrs: string; content: string; mainId: string }
const { lang, head, bodyAttrs, content, mainId } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <Fragment set:html={head} />
</head>
<body data-page-role={bodyAttrs.includes('data-page-role="tool"') ? "tool" : undefined}>
  <a href={'#'+mainId} class="site-skip sr-only focus:not-sr-only focus:fixed focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-3">跳到主要内容</a>
  <Fragment set:html={content} />
</body>
</html>
