---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../lib/legacy-pages.mjs';
export function getStaticPaths() {
  return pages().map(page=>({params:{route:page.route||undefined},props:page}));
}
const { lang, head, content, mainId } = Astro.props;
---
<SiteLayout {lang} {head} {content} {mainId} />
