<script is:inline>
"use strict";
const cards=[...document.querySelectorAll('.shop')];
let currentRegion='all',currentStation=null,currentSize='all',currentStock='all',map=null;
const markers=new Map(),groups=new Map();
const mapStatus=document.getElementById('map-message');
const models=card=>[...card.querySelectorAll('.stock-row')].filter(row=>currentSize==='all'||row.dataset.size===currentSize);
const states=card=>models(card).map(row=>row.dataset.status);
const matchesStock=card=>currentStock==='all'||states(card).some(x=>currentStock==='in'?x==='in':currentStock==='out'?['out','unavailable'].includes(x):['unknown','unlisted','candidate'].includes(x));
function visible(card){return(currentRegion==='all'||card.dataset.region===currentRegion)&&(!currentStation||card.dataset.station===currentStation)&&matchesStock(card)}
function label(card){return card.querySelector('h3').textContent}
function number(card){return card.querySelector('.number').textContent}
function coords(card){return [Number(card.dataset.lat),Number(card.dataset.lng)]}
function groupKey(card){return coords(card).join(',')}
function linkFor(card,transit){const address=card.querySelector('address').textContent;const q=encodeURIComponent(label(card)+' '+address+' 香港');return transit?'https://www.google.com/maps/dir/?api=1&destination='+q+'&travelmode=transit':'https://www.google.com/maps/search/?api=1&query='+q}
function focusShop(card,scroll=true){cards.forEach(c=>c.classList.toggle('active',c===card));if(map){map.setView(coords(card),17);markers.get(groupKey(card))?.openPopup()}if(scroll)card.scrollIntoView({block:'nearest',behavior:'smooth'})}
function color(group){const s=group.flatMap(states);return s.includes('in')?'in':s.includes('candidate')?'candidate':s.every(x=>['out','unavailable'].includes(x))?'out':'unknown'}
function popupFor(group){const popup=document.createElement('div');popup.className='stock-popup';group.forEach(card=>{const section=document.createElement('section');const strong=document.createElement('strong');strong.textContent=number(card)+' · '+label(card);section.append(strong);models(card).forEach(row=>{const p=document.createElement('p');p.textContent=[row.querySelector('strong').textContent,row.querySelector('.stock-state').textContent,row.querySelector('.stock-price').textContent].join(' · ');section.append(p);const deal=row.querySelector('.stock-deal');if(deal){const dp=document.createElement('p');dp.textContent=deal.textContent;section.append(dp)}});const address=document.createElement('p');address.textContent=card.querySelector('address').textContent;section.append(address);const b=document.createElement('button');b.type='button';b.textContent='查看门店与联系方式';b.addEventListener('click',()=>{cards.forEach(c=>c.classList.toggle('active',c===card));card.scrollIntoView({block:'center',behavior:'smooth'})});section.append(b);popup.append(section)});return popup}
function refresh(){
 const shown=cards.filter(visible);cards.forEach(card=>{card.hidden=!shown.includes(card);card.querySelectorAll('.stock-row').forEach(row=>{row.hidden=currentSize!=='all'&&row.dataset.size!==currentSize})});
 document.getElementById('stock-count').textContent=shown.length+' 家门店';
 document.getElementById('stock-empty').hidden=shown.length!==0;
 document.querySelectorAll('button[data-region]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.region===currentRegion&&!currentStation)));
 document.querySelectorAll('button[data-station]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.station===currentStation)));
 document.querySelectorAll('button[data-size-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.sizeFilter===currentSize)));
 document.querySelectorAll('button[data-stock-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.stockFilter===currentStock)));
 if(map){markers.forEach(m=>map.removeLayer(m));markers.clear();groups.clear();shown.forEach(c=>{const k=groupKey(c);if(!groups.has(k))groups.set(k,[]);groups.get(k).push(c)});
 groups.forEach((group,k)=>{const cls=color(group);const nums=group.map(number).join('/');const w=group.length>1?76:32;
 const icon=L.divIcon({html:'<span class="marker '+cls+(group.length>1?' multi':'')+'">'+nums+'</span>',className:'',iconSize:[w,32],iconAnchor:[w/2,32]});
 const marker=L.marker(coords(group[0]),{icon,title:group.map(label).join(' / ')}).bindPopup(popupFor(group));marker.on('click',()=>{cards.forEach(c=>c.classList.toggle('active',group.includes(c)))});marker.addTo(map);markers.set(k,marker)});
 if(shown.length)map.fitBounds(shown.map(coords),{padding:[35,35],maxZoom:15})}
}
document.querySelectorAll('button[data-region]').forEach(b=>b.addEventListener('click',()=>{currentRegion=b.dataset.region;currentStation=null;refresh()}));
document.querySelectorAll('button[data-station]').forEach(b=>b.addEventListener('click',()=>{currentStation=b.dataset.station===currentStation?null:b.dataset.station;currentRegion='all';refresh();document.getElementById('locations').scrollIntoView({block:'start',behavior:'smooth'})}));
document.querySelectorAll('button[data-size-filter]').forEach(b=>b.addEventListener('click',()=>{currentSize=b.dataset.sizeFilter;refresh()}));
document.querySelectorAll('button[data-stock-filter]').forEach(b=>b.addEventListener('click',()=>{currentStock=b.dataset.stockFilter;refresh()}));
cards.forEach(card=>{const actions=card.querySelector('.actions');const transit=document.createElement('a');transit.href=linkFor(card,true);transit.target='_blank';transit.rel='noopener noreferrer';transit.textContent='港铁导航 ↗';actions.prepend(transit);const focus=document.createElement('button');focus.type='button';focus.textContent='在地图上定位';focus.addEventListener('click',()=>focusShop(card));actions.prepend(focus)});
document.addEventListener('DOMContentLoaded',()=>{if(!window.L){mapStatus.textContent='街道底图未加载；仍可使用完整门店列表及港铁导航。';refresh();return}try{map=L.map('store-map',{scrollWheelZoom:false}).setView([22.3,114.18],12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19}).on('tileerror',()=>{mapStatus.textContent='部分街道底图暂不可用；门店地址及港铁导航仍可使用。'}).addTo(map);mapStatus.textContent='数字对应门店；同栋门店合并标记。绿色为网店已核实有货；橙色为可加购但条码待核。实体店仍须确认。'}catch(e){mapStatus.textContent='地图底图无法初始化，门店列表及港铁导航仍可使用。';map=null;markers.clear()}refresh()});
</script>
