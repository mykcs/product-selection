<script is:inline>
"use strict";
const cards=[...document.querySelectorAll('.shop')];
let currentRegion='all',currentStation=null,currentSize='28',currentStock='buyable',map=null;
const markers=new Map(),groups=new Map();
const mapStatus=document.getElementById('map-message');
const allRows=card=>[...card.querySelectorAll('.stock-row')];
const stockMatches=(status,filter)=>filter==='all'||(filter==='buyable'?['in','candidate'].includes(status):filter==='pending'?status==='unknown':filter==='out'?['out','unavailable'].includes(status):status===filter);
const models=(card,size=currentSize,stockFilter=currentStock)=>allRows(card).filter(row=>(size==='all'||row.dataset.size===size)&&stockMatches(row.dataset.status,stockFilter));
const states=card=>models(card).map(row=>row.dataset.status);
const locationMatches=(card,region,station)=>(region==='all'||card.dataset.region===region)&&(!station||card.dataset.station===station);
function visible(card,size=currentSize,stockFilter=currentStock,region=currentRegion,station=currentStation){return locationMatches(card,region,station)&&models(card,size,stockFilter).length>0}
const countFor=(size,stockFilter,region,station)=>cards.filter(card=>visible(card,size,stockFilter,region,station)).length;
const defaults={size:'28',stock:'buyable',region:'all',station:null};
const valid=(value,options,fallback)=>options.includes(value)?value:fallback;
function readFilters(){const q=new URLSearchParams(location.search);currentSize=valid(q.get('size'),['all','26','28'],defaults.size);currentStock=valid(q.get('stock'),['all','buyable','in','candidate','pending','unlisted','out'],defaults.stock);currentRegion=valid(q.get('region'),['all','kowloon','kwun-tong','island'],defaults.region);currentStation=cards.some(c=>c.dataset.station===q.get('station'))?q.get('station'):null;if(currentStation)currentRegion='all'}
function writeFilters(){const url=new URL(location.href);for(const [key,value] of Object.entries({size:currentSize,stock:currentStock,region:currentRegion,station:currentStation})){if(!value||value===defaults[key])url.searchParams.delete(key);else url.searchParams.set(key,value)}if(url.href!==location.href)history.replaceState(null,'',url)}
function resetFilters(){currentRegion=defaults.region;currentStation=defaults.station;currentSize=defaults.size;currentStock=defaults.stock;refresh()}
function renderActive(){const box=document.getElementById('active-filters');box.replaceChildren();if(currentStation){const button=document.createElement('button');button.type='button';button.dataset.removeFilter='station';button.textContent=currentStation+'站 ×';button.setAttribute('aria-label','取消 '+currentStation+'站筛选');button.addEventListener('click',()=>{currentStation=null;refresh()});box.append(button)}box.hidden=!currentStation;document.getElementById('reset-filters').disabled=currentSize===defaults.size&&currentStock===defaults.stock&&currentRegion===defaults.region&&!currentStation}
const ranking={in:0,candidate:1,unknown:2,unavailable:3,out:4,unlisted:5};
const rank=card=>Math.min(...models(card).map(row=>ranking[row.dataset.status]??6));
const priceRank=card=>Math.min(...models(card).map(row=>row.dataset.price?Number(row.dataset.price):Infinity));
function label(card){return card.querySelector('h3').textContent}
function number(card){return card.querySelector('.number').textContent}
function coords(card){return [Number(card.dataset.lat),Number(card.dataset.lng)]}
function groupKey(card){return coords(card).join(',')}
function linkFor(card,transit){const address=card.querySelector('address').textContent;const q=encodeURIComponent(label(card)+' '+address+' 香港');return transit?'https://www.google.com/maps/dir/?api=1&destination='+q+'&travelmode=transit':'https://www.google.com/maps/search/?api=1&query='+q}
function focusShop(card,scroll=true){cards.forEach(c=>c.classList.toggle('active',c===card));if(map){map.setView(coords(card),17,{animate:false});markers.get(groupKey(card))?.openPopup()}if(scroll)document.getElementById('map-panel').scrollIntoView({block:'nearest',behavior:'smooth'})}
function color(group){const s=group.flatMap(states);return s.includes('in')?'in':s.includes('candidate')?'candidate':s.every(x=>['out','unavailable'].includes(x))?'out':'unknown'}
function popupFor(group){const popup=document.createElement('div');popup.className='stock-popup';group.forEach(card=>{const section=document.createElement('section');const strong=document.createElement('strong');strong.textContent=number(card)+' · '+label(card);section.append(strong);models(card).forEach(row=>{const p=document.createElement('p');p.textContent=[row.querySelector('strong').textContent,row.querySelector('.stock-state').textContent,row.querySelector('.stock-price').textContent].join(' · ');section.append(p);const deal=row.querySelector('.stock-deal');if(deal){const dp=document.createElement('p');dp.textContent=deal.textContent;section.append(dp)}});const address=document.createElement('p');address.textContent=card.querySelector('address').textContent;section.append(address);const b=document.createElement('button');b.type='button';b.textContent='查看门店与联系方式';b.addEventListener('click',()=>{cards.forEach(c=>c.classList.toggle('active',c===card));card.scrollIntoView({block:'center',behavior:'smooth'})});section.append(b);popup.append(section)});return popup}
function refresh(){
 const shown=cards.filter(card=>visible(card)).sort((a,b)=>rank(a)-rank(b)||priceRank(a)-priceRank(b)||Number(number(a))-Number(number(b)));
 const list=document.getElementById('shop-list');shown.forEach(card=>list.append(card));
 cards.forEach(card=>{card.hidden=!shown.includes(card);const matching=models(card);allRows(card).forEach(row=>{row.hidden=!matching.includes(row)});if(card.hidden)card.classList.remove('active')});
 const confirmed=shown.filter(card=>models(card).some(row=>row.dataset.status==='in')).length;
 const candidate=shown.filter(card=>models(card).some(row=>row.dataset.status==='candidate')).length;
 document.getElementById('stock-count').textContent=shown.length+' 家门店 · 已核实网店有货 '+confirmed+' 家 · 待核码 '+candidate+' 家';
 document.getElementById('stock-empty').hidden=shown.length!==0;
 document.querySelectorAll('[data-overview-size]').forEach(x=>{x.hidden=currentSize!=='all'&&x.dataset.overviewSize!==currentSize});
 document.querySelectorAll('button[data-station]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.station===currentStation)));
 document.querySelectorAll('button[data-size-filter]').forEach(x=>{x.setAttribute('aria-pressed',String(x.dataset.sizeFilter===currentSize));x.setAttribute('aria-label',x.dataset.label)});
 document.getElementById('stock-filter').value=currentStock;document.getElementById('region-filter').value=currentRegion;
 document.querySelectorAll('option[data-stock-filter]').forEach(x=>{x.textContent=x.dataset.label+' · '+countFor(currentSize,x.value,currentRegion,currentStation)+' 家'});
 document.querySelectorAll('option[data-region-filter]').forEach(x=>{x.textContent=x.dataset.label+' · '+countFor(currentSize,currentStock,x.value,null)+' 家'});
 renderActive();writeFilters();
 if(map){markers.forEach(m=>map.removeLayer(m));markers.clear();groups.clear();shown.forEach(c=>{const k=groupKey(c);if(!groups.has(k))groups.set(k,[]);groups.get(k).push(c)});
 groups.forEach((group,k)=>{const cls=color(group);const nums=group.map(number).sort((a,b)=>Number(a)-Number(b)).join('/');const w=group.length>1?76:32;
 const icon=L.divIcon({html:'<span class="marker '+cls+(group.length>1?' multi':'')+'">'+nums+'</span>',className:'',iconSize:[w,32],iconAnchor:[w/2,32]});
 const marker=L.marker(coords(group[0]),{icon,title:group.map(label).join(' / '),zIndexOffset:group.length>1?1000:0}).bindPopup(popupFor(group));marker.on('click',()=>{cards.forEach(c=>c.classList.toggle('active',group.includes(c)))});marker.addTo(map);markers.set(k,marker)});
 if(shown.length)map.fitBounds(shown.map(coords),{padding:[35,35],maxZoom:15,animate:false});else map.setView([22.3,114.18],12,{animate:false})}
}
document.getElementById('region-filter').addEventListener('change',e=>{currentRegion=e.target.value;currentStation=null;refresh()});
document.querySelectorAll('button[data-station]').forEach(b=>b.addEventListener('click',()=>{currentStation=b.dataset.station===currentStation?null:b.dataset.station;currentRegion='all';refresh();document.getElementById('locations').scrollIntoView({block:'start',behavior:'smooth'})}));
document.querySelectorAll('button[data-size-filter]').forEach(b=>b.addEventListener('click',()=>{currentSize=b.dataset.sizeFilter;refresh()}));
document.getElementById('stock-filter').addEventListener('change',e=>{currentStock=e.target.value;refresh()});
document.getElementById('reset-filters').addEventListener('click',resetFilters);
document.getElementById('metro-link').addEventListener('click',()=>{document.getElementById('official-guide').open=true});
readFilters();
window.addEventListener('popstate',()=>{readFilters();refresh()});
cards.forEach(card=>{const actions=card.querySelector('.actions');const contact=card.querySelector('.merchant-channels a[href*="wa.me"], .merchant-channels a[href*="whatsapp.com"]');if(contact){const primary=contact.cloneNode(false);primary.classList.add('contact-primary');primary.textContent='WhatsApp ↗';actions.prepend(primary)}const transit=document.createElement('a');transit.href=linkFor(card,true);transit.target='_blank';transit.rel='noopener noreferrer';transit.textContent='港铁导航 ↗';actions.prepend(transit);const focus=document.createElement('button');focus.type='button';focus.textContent='地图定位';focus.addEventListener('click',()=>focusShop(card));actions.prepend(focus)});
refresh();
document.addEventListener('DOMContentLoaded',()=>{if(!window.L){mapStatus.textContent='街道底图未加载；仍可使用完整门店列表及港铁导航。';refresh();return}try{map=L.map('store-map',{scrollWheelZoom:false}).setView([22.3,114.18],12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19}).on('tileerror',()=>{mapStatus.textContent='部分街道底图暂不可用；门店地址及港铁导航仍可使用。'}).addTo(map);mapStatus.textContent='数字对应门店；同栋门店合并标记。点击标记查看价格和门店。'}catch(e){mapStatus.textContent='地图底图无法初始化，门店列表及港铁导航仍可使用。';map=null;markers.clear()}refresh()});
</script>
