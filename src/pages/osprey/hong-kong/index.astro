<script is:inline>
"use strict";
const cards=[...document.querySelectorAll('.shop')];let currentRegion='all',currentStation=null,map=null,markers=new Map();
const list=document.getElementById('shop-list');const mapStatus=document.getElementById('map-message');
function visible(card){return(currentRegion==='all'||card.dataset.region===currentRegion)&&(!currentStation||card.dataset.station===currentStation)}
function label(card){return card.querySelector('h3').textContent}
function linkFor(card,transit){const address=card.querySelector('address').textContent;const q=encodeURIComponent(label(card)+' '+address+' 香港');return transit?'https://www.google.com/maps/dir/?api=1&destination='+q+'&travelmode=transit':'https://www.google.com/maps/search/?api=1&query='+q}
function focusShop(card){if(!visible(card)){currentRegion='all';currentStation=null;refresh()}cards.forEach(c=>c.classList.toggle('active',c===card));if(map){const loc=[Number(card.dataset.lat),Number(card.dataset.lng)];map.setView(loc,16);markers.get(card.id)?.openPopup()}card.scrollIntoView({block:'nearest',behavior:'smooth'})}
function refresh(){let count=0;cards.forEach(card=>{const active=visible(card);card.hidden=!active;if(active)count++;if(map){const marker=markers.get(card.id);if(active)marker.addTo(map);else map.removeLayer(marker)}});document.querySelectorAll('.filters button[data-region]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.region===currentRegion)));document.querySelectorAll('.stations button[data-station]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.station===currentStation)));if(map&&count){map.fitBounds(cards.filter(visible).map(c=>[Number(c.dataset.lat),Number(c.dataset.lng)]),{padding:[35,35],maxZoom:14})}}
document.querySelectorAll('.filters button[data-region]').forEach(b=>b.addEventListener('click',()=>{currentRegion=b.dataset.region;currentStation=null;refresh()}));document.querySelectorAll('.stations button[data-station]').forEach(b=>b.addEventListener('click',()=>{currentStation=b.dataset.station===currentStation?null:b.dataset.station;currentRegion='all';refresh();document.getElementById('locations').scrollIntoView({block:'start',behavior:'smooth'})}));
cards.forEach((card,i)=>{const actions=card.querySelector('.actions');const transit=document.createElement('a');transit.href=linkFor(card,true);transit.target='_blank';transit.rel='noopener noreferrer';transit.textContent='港铁导航 ↗';actions.prepend(transit);const focus=document.createElement('button');focus.type='button';focus.textContent='在地图上定位';focus.addEventListener('click',()=>focusShop(card));actions.prepend(focus)});
document.addEventListener('DOMContentLoaded',()=>{if(!window.L){mapStatus.textContent='街道底图未加载；仍可使用完整门店列表及港铁导航。';refresh();return}try{map=L.map('store-map',{scrollWheelZoom:false}).setView([22.3,114.18],12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19}).on('tileerror',()=>{mapStatus.textContent='部分街道底图暂不可用；门店地址及港铁导航仍可使用。'}).addTo(map);cards.forEach((card,i)=>{const cls=card.querySelector('.category').textContent.startsWith('总代理')?'':' dealer';const icon=L.divIcon({html:'<span class="marker'+cls+'">'+(i+1)+'</span>',className:'',iconSize:[32,32],iconAnchor:[16,32]});const marker=L.marker([Number(card.dataset.lat),Number(card.dataset.lng)],{icon,title:label(card)});const popup=document.createElement('div');const strong=document.createElement('strong');strong.textContent=label(card);const text=document.createElement('p');text.textContent=card.querySelector('address').textContent;popup.append(strong,text);marker.bindPopup(popup);marker.on('click',()=>{cards.forEach(c=>c.classList.toggle('active',c===card))});markers.set(card.id,marker)});mapStatus.textContent='地图数字对应下方门店。部分坐标为建筑附近或街道级近似，实际入口以门店地址和导航为准。'}catch(e){mapStatus.textContent='地图底图无法初始化，门店列表及港铁导航仍可使用。';map=null;markers.clear()}refresh()});
</script>
