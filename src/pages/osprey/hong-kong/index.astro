---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import MainContent from "../../../components/MainContent.astro";
import HkStockSummary from "../../../components/HkStockSummary.astro";
import stock from "../../../data/osprey-hk-stock.json";
type Offer = {status:string; price?:number; qty?:number; promotion?:{single:number;label:string;verification:string;pairUnit?:number}};
type Entry = {"26"?:Offer; "28"?:Offer};
const summary = (["26","28"] as const).map(size=>{
  const available=Object.values(stock.stores as Record<string,Entry>).map(store=>store[size]).filter((o):o is Offer=>!!o && o.status==="in");
  const prices=available.flatMap(o=>o.price===undefined?[]:[o.price]);
  const candidates=Object.values(stock.stores as Record<string,Entry>).map(store=>store[size]).filter((o):o is Offer=>!!o && o.status==="candidate");
  const candidatePrices=candidates.flatMap(o=>o.promotion?[o.promotion.single]:[]);
  return {size,count:available.length,lowest:prices.length?Math.min(...prices):null,candidateCount:candidates.length,candidateLowest:candidatePrices.length?Math.min(...candidatePrices):null};
});
const dateText=stock.checkedAt.replace(/-(\d{2})-(\d{2})$/,(_,m,d)=>"年"+Number(m)+"月"+Number(d)+"日");
---
<SiteLayout lang="zh-CN">
<Fragment slot="head">

<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="香港 Osprey 官方代理与经销商地图：港铁油麻地、旺角、湾仔、铜锣湾门店与楼层、路线和地图导航。">
<title>香港 Hikelite 库存地图｜选购商品</title>
<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
<script is:inline src="/assets/vendor/leaflet/leaflet.js" defer></script>
<style is:inline>
:root{color-scheme:light;--bg:#f5f6f4;--paper:#fff;--ink:#202720;--muted:#59675d;--line:#dce5da;--green:#35674b;--tint:#eef5ef;--red:#d7474b;--kwun:#2e976d;--island:#3379c1}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink)}
a{color:var(--green)}a:focus-visible,button:focus-visible{outline:3px solid #84b890;outline-offset:3px}
.top{display:flex;justify-content:space-between;gap:var(--space-4);align-items:center;padding:var(--space-6) 0;font-size:var(--text-caption)}.top a{text-decoration:none;font-weight:var(--weight-heading)}.top span,.intro,.caption,.secondary{color:var(--muted)}
.hero{padding:var(--space-8) 0 var(--space-7)}.eyebrow{font-size:var(--text-caption);font-weight:var(--weight-heading);letter-spacing:var(--tracking-label);color:var(--green)}h1{font-size:var(--text-hero);letter-spacing:var(--tracking-heading);line-height:var(--leading-tight);margin:var(--space-3) 0 var(--space-6);max-width:var(--width-heading)}h2{font-size:var(--text-section);letter-spacing:var(--tracking-heading);line-height:var(--leading-heading);margin:0 0 var(--space-3)}h3{font-size:var(--text-lead);letter-spacing:var(--tracking-heading);margin:0 0 var(--space-3);line-height:var(--leading-heading)}p{margin:0}.intro{max-width:var(--width-reading);font-size:var(--text-lead)}.chips{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-6)}.chips span{font-size:var(--text-caption);font-weight:var(--weight-heading);border-radius:100px;background:var(--tint);color:var(--green);padding:var(--space-3) var(--space-4)}
.panel{border:1px solid var(--line);background:var(--paper);border-radius:22px;padding:var(--space-panel);margin-bottom:var(--space-section);min-width:0}.split{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--space-5)}.split .panel{margin-bottom:var(--space-5)}.label{font-size:var(--text-caption);font-weight:var(--weight-heading);color:var(--green)}.notice{font-size:var(--text-small);color:var(--muted)}.notice strong{color:var(--ink)}.notice a{font-weight:var(--weight-heading)}.notice p+p{margin-top:var(--space-3)}
.sectionhead{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}.sectionhead>a{font-size:var(--text-caption);font-weight:var(--weight-heading)}.legend{display:flex;gap:var(--space-5);flex-wrap:wrap;color:var(--muted);font-size:var(--text-caption);margin:var(--space-2) 0 var(--space-5)}.legend i{width:12px;height:12px;display:inline-block;border-radius:50%;margin-right:var(--space-3);vertical-align:-1px}.legend .red{background:var(--red)}.legend .green{background:var(--kwun)}.legend .blue{background:var(--island)}
.diagram-wrap{overflow-x:auto;scrollbar-color:#a7b7ab transparent}.diagram{width:100%;min-width:var(--width-map-min);max-width:var(--width-map-max);display:block}.diagram text{font-family:var(--font-body)}.stations{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-3)}.stations button,.filters button{border:1px solid var(--line);border-radius:100px;background:var(--paper);color:var(--ink);font-family:inherit;font-size:var(--text-caption);font-weight:var(--weight-heading);line-height:var(--leading-control);padding:var(--space-3) var(--space-5);cursor:pointer}.stations button[aria-pressed=true],.filters button[aria-pressed=true]{background:var(--green);border-color:var(--green);color:white}.caption{font-size:var(--text-caption);margin-top:var(--space-3)}
.filters{display:flex;flex-wrap:wrap;gap:var(--space-3);margin:var(--space-5) 0}.filters button{font-family:inherit;font-size:var(--text-caption);font-weight:var(--weight-heading)}.count{font-size:var(--text-caption);color:var(--muted)}
#store-map{height:420px;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#e7ece7}.map-message{font-size:var(--text-caption);color:var(--muted);margin:var(--space-3) 0 0}.map-message[hidden]{display:none}.leaflet-container{font-family:var(--font-body);font-size:var(--text-caption);line-height:var(--leading-control)}.leaflet-control-attribution,.leaflet-control-attribution a{font-size:var(--text-caption);line-height:var(--leading-control)}#store-map .leaflet-bar a{font-family:var(--font-body);font-size:var(--text-lead);line-height:var(--leading-control);display:grid;place-items:center}.leaflet-popup-content{font-size:var(--text-small);line-height:var(--leading-body)}#store-map .leaflet-popup-close-button{font-size:var(--text-lead);line-height:var(--leading-control)}.marker{width:32px;height:32px;display:grid;place-items:center;border-radius:50%;background:#28583c;border:2px solid white;box-shadow:0 2px 9px #17342377;color:white;font-family:var(--font-body);font-size:var(--text-small);font-weight:var(--weight-heading);line-height:var(--leading-control)}.marker.dealer{background:#205d85}
.shops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-5)}.shop{border:1px solid var(--line);border-radius:18px;padding:var(--space-5);min-width:0;scroll-margin-top:24px}.shop:focus-within,.shop.active{border-color:#8dab96;background:var(--tint)}.shop-top{display:flex;align-items:center;gap:var(--space-3)}.number{background:var(--tint);color:var(--green);padding:var(--space-2) var(--space-3);border-radius:9px;font-size:var(--text-caption);font-weight:var(--weight-heading)}.category{color:var(--muted);font-size:var(--text-caption)}.shop h3{margin-top:var(--space-4)}.shop address{font-size:var(--text-caption);font-style:normal;line-height:var(--leading-body)}.mtr-note{color:var(--green);font-size:var(--text-caption);font-weight:var(--weight-heading);margin-top:var(--space-3)}.shop .info{font-size:var(--text-caption);color:var(--muted);margin-top:var(--space-3)}.shop .actions{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-4)}.shop .actions a,.shop .actions button{border:1px solid var(--line);border-radius:100px;padding:var(--space-3) var(--space-4);background:var(--paper);color:var(--green);font-family:inherit;font-size:var(--text-caption);font-weight:var(--weight-heading);text-decoration:none;cursor:pointer}.shop .actions a:hover,.shop .actions button:hover{border-color:var(--green)}

/* Merchant-published social links are separate from geolocation, MTR navigation,
   and dated per-store stock claims. Shared brand accounts are labelled as such. */
.merchant-channels{border-top:1px solid var(--line);margin-top:var(--space-5);padding-top:var(--space-4)}
.merchant-channels-title{font-size:var(--text-caption);font-weight:var(--weight-heading);color:var(--ink)}
.merchant-channels-links{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-3)}
.merchant-channels-links a{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:100px;padding:var(--space-3) var(--space-4);background:var(--paper);color:var(--green);font-size:var(--text-caption);font-weight:var(--weight-heading);text-decoration:none}
.merchant-channels-links a:hover{border-color:var(--green);background:var(--tint)}
.merchant-channels .merchant-channel-note{font-size:var(--text-caption);line-height:var(--leading-body);color:var(--muted);margin-top:var(--space-3)}
.shop .info a{font-weight:var(--weight-heading);color:var(--green);text-underline-offset:2px}
.agent-channels{font-size:var(--text-caption);color:var(--muted)}
.agent-channels a{font-weight:var(--weight-heading)}
.ending{background:var(--tint);padding:var(--space-5) var(--space-5);border-radius:14px;color:var(--muted);font-size:var(--text-caption);margin-top:var(--space-5)}.ending strong{color:var(--ink)}footer{padding:var(--space-6) 0 var(--space-9);color:var(--muted);font-size:var(--text-caption)}footer p+p{margin-top:var(--space-3)}[hidden]{display:none!important}
@media(max-width:740px){.split,.shops{grid-template-columns:1fr}.sectionhead{display:block}.sectionhead>a{display:inline-block;margin-top:var(--space-3)}}
@media(max-width:600px){.intro{font-size:var(--text-body)}.panel{border-radius:18px}#store-map{height:360px}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#101610;--paper:#1b241c;--ink:#eef5ef;--muted:#b5c6b8;--line:#354638;--green:#9fceab;--tint:#28392a}.marker{border-color:#18251c}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#1b241c;color:#eef5ef}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.hero{padding:var(--space-4) 0 var(--space-5)}.hero h1{font-size:var(--text-section);margin:var(--space-2) 0 var(--space-3);max-width:none}.hero .intro{font-size:var(--text-body)}.snapshot{font-size:var(--text-caption);color:var(--muted);margin-top:var(--space-4)}
.stock-overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:var(--space-4) 0}
.stock-overview div{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-2) var(--space-3);min-width:0}.stock-overview span,.stock-overview small{font-size:var(--text-caption);color:var(--muted)}.stock-overview strong{font-size:var(--text-title);color:var(--green)}
.stock-summary{margin-top:var(--space-4);padding-top:var(--space-3);border-top:1px solid var(--line)}
.stock-row{display:grid;grid-template-columns:3rem minmax(0,1fr) auto auto;align-items:center;gap:var(--space-2);padding:var(--space-3) 0;font-size:var(--text-small);border-bottom:1px solid var(--line)}
.stock-price{font-variant-numeric:tabular-nums;white-space:nowrap}.stock-row a{font-size:var(--text-caption);white-space:nowrap}.stock-state{font-size:var(--text-caption);font-weight:var(--weight-heading)}
.stock-state.in{color:var(--green)}.stock-state.out,.stock-state.unavailable{color:var(--stock-out)}.stock-state.unknown,.stock-state.unlisted{color:var(--muted)}
.branch-state,.stock-note,.stock-evidence{font-size:var(--text-caption);line-height:var(--leading-body);color:var(--muted);margin-top:var(--space-3)}.stock-evidence summary{cursor:pointer;color:var(--green)}
:root{--stock-out:#b6383f;--stock-neutral:#63736b;--stock-in:#23794a}
#locations .sectionhead{margin-bottom:var(--space-4)}#locations .sectionhead h2{font-size:var(--text-card)}.inventory-controls{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-3) var(--space-5);margin:var(--space-4) 0}.inventory-controls .filters{margin:0}.inventory-controls .filters+ .filters{border-left:1px solid var(--line);padding-left:var(--space-4)}.stock-legend{margin:var(--space-3) 0}.stock-legend .in,.marker.in{background:var(--stock-in)}.stock-legend .out,.marker.out{background:var(--stock-out)}.stock-legend .unknown,.marker.unknown{background:var(--stock-neutral)}
.marker{width:auto;padding:0 var(--space-2);white-space:nowrap}.marker.multi{font-size:var(--text-caption)}.stock-popup{overflow-wrap:anywhere}.stock-popup section+section{border-top:1px solid var(--line);padding-top:var(--space-3);margin-top:var(--space-3)}.stock-popup p{margin:var(--space-2) 0}.stock-popup button{font:inherit;background:transparent;border:0;color:var(--green);text-decoration:underline;cursor:pointer;padding:0}
@media(max-width:600px){.hero .intro{font-size:var(--text-small)}.stock-overview div{display:grid;gap:var(--space-2)}.inventory-controls{gap:var(--space-3)}.inventory-controls .filters+ .filters{border:0;padding-left:0}.inventory-controls .filters{gap:var(--space-2)}.inventory-controls .filters button{padding:var(--space-2) var(--space-3);min-height:36px}.stock-row{grid-template-columns:2.5rem minmax(0,1fr) auto;gap:var(--space-2)}.stock-row a{grid-column:2/-1}.stock-overview{gap:var(--space-3)}}
@media(prefers-color-scheme:dark){:root{--stock-out:#ff9a9f;--stock-in:#23794a}.marker.out,.stock-legend .out{background:#ad3e45}}
.evidence-links{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-3);margin-top:var(--space-2)}.lead-evidence{border-top:1px solid var(--line);margin-top:var(--space-5);padding-top:var(--space-4);font-size:var(--text-small)}.lead-evidence summary{cursor:pointer;color:var(--green);font-weight:var(--weight-heading)}.lead-body{margin-top:var(--space-3)}.lead-entry{margin-top:var(--space-4);padding-top:var(--space-3);border-top:1px solid var(--line)}.lead-body p+p,.lead-entry p{margin-top:var(--space-2)}
.stock-state.candidate,.candidate-overview{color:#a05a14}.stock-legend .candidate,.marker.candidate{background:#a05a14}.stock-deal{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-2) var(--space-3);font-size:var(--text-caption);color:var(--muted)}.stock-deal strong{color:var(--ink);font-size:var(--text-small);font-variant-numeric:tabular-nums}.stock-overview .candidate-overview{width:100%}@media(prefers-color-scheme:dark){.stock-state.candidate,.stock-overview .candidate-overview{color:#f2b568}}
</style></Fragment>
<MainContent>
<nav class="top"><a href="/osprey/">← 小鹰背包选购</a><span>香港门店 · 港铁导购</span></nav>
<header class="hero"><div class="eyebrow">OSPREY HONG KONG · HIKELITE S26</div><h1>香港骇客背包库存地图</h1><p class="intro">2026 新款 · 普通黑色 Raven Black · 26 / 28 L。</p><p class="snapshot">库存快照 · <time datetime={stock.checkedAt}>{dateText}</time> · 港币 · 非实时</p></header>
<section class="panel" id="locations"><div class="sectionhead"><div><h2>门店与库存</h2><p class="notice">网店库存不等于实体店现货。点击标记看详情；同栋门店共用标记。</p></div><a href="#metro">港铁路线 ↓</a></div>
<div class="stock-overview" aria-label="现货概览">{summary.map(item=><div><span>{item.size} L · 黑色</span><strong>{item.count} 家</strong><small>{item.lowest===null?"暂无已核实现货价":"最低已核实现货标价 HK$"+item.lowest.toLocaleString("en-US")} · <a href={stock.officialReference.url} target="_blank" rel="noopener noreferrer">{"官网参考 HK$"+stock.products[item.size].regular.toLocaleString("en-US")} ↗</a></small>{item.candidateLowest!==null && <small class="candidate-overview">{item.candidateCount} 家可加购待核码 · 折后候选 {"HK$"+item.candidateLowest.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2})} 起（条件见门店）</small>}</div>)}</div>
<div class="inventory-controls"><div class="filters" role="group" aria-label="容量筛选"><button data-size-filter="all" aria-pressed="true">26 + 28 L</button><button data-size-filter="26" aria-pressed="false">26 L</button><button data-size-filter="28" aria-pressed="false">28 L</button></div>
<div class="filters" role="group" aria-label="库存筛选"><button data-stock-filter="all" aria-pressed="true">全部库存</button><button data-stock-filter="in" aria-pressed="false">网店有货</button><button data-stock-filter="pending" aria-pressed="false">待核实</button><button data-stock-filter="out" aria-pressed="false">缺货 / 不可售</button></div>
<div class="filters" role="group" aria-label="门店区域筛选"><button data-region="all" aria-pressed="true">全部 16 家</button><button data-region="kowloon" aria-pressed="false">油麻地 / 旺角</button><button data-region="kwun-tong" aria-pressed="false">观塘</button><button data-region="island" aria-pressed="false">湾仔 / 铜锣湾</button></div></div>
<div class="legend stock-legend"><span><i class="in"></i>网店有货</span><span><i class="candidate"></i>可加购 · 条码待核</span><span><i class="out"></i>网店缺货 / 不可售</span><span><i class="unknown"></i>待确认 / 未列黑色</span></div><p id="stock-count" class="count" aria-live="polite">16 家门店</p><div id="store-map" role="region" aria-label="香港 Osprey 经销门店街道地图"></div><p id="map-message" class="map-message">若街道底图无法显示，下方门店地址及外部导航仍然可用。</p>
<p id="stock-empty" class="notice" hidden>没有符合筛选的门店。可切换地区、容量或库存条件。</p><div class="shops" id="shop-list">
<article class="shop" id="campzone" data-lat="22.31394" data-lng="114.17021" data-region="kowloon" data-station="油麻地"><div class="shop-top"><span class="number">14</span><span class="category">官网门店 · 建筑物定位</span></div><h3>Campzone Outdoor · 安利大厦</h3><address>油麻地弥敦道545号安利大厦11楼全层</address><p class="mtr-note">港铁油麻地站 A1 出口 · 每日13:00–21:00</p><p class="info">电话：<a href="tel:+85225177733">2517 7733</a></p><HkStockSummary storeId="campzone" /><div class="actions"><a href="https://www.campzoneoutdoor.com/pages/direction" target="_blank" rel="noopener noreferrer">店方官网 ↗</a></div><div class="merchant-channels" aria-label="商家公开联系方式"><div class="merchant-channels-title">联系商家</div><div class="merchant-channels-links"><a href="https://wa.me/85296777241" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div><p class="merchant-channel-note">到店前请确认吊牌、现场库存、活动有效时间与自取。</p></div></article>
